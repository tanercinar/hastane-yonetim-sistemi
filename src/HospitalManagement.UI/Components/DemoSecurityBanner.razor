@inject IStringLocalizer<SharedResources> Localizer

<aside class="demo-security-banner" role="region" aria-label="@Localizer["DemoBannerTitle"]">
    <div class="demo-security-banner__content">
        <div class="demo-security-banner__badge">
            <svg viewBox="0 0 24 24" class="demo-security-banner__icon" aria-hidden="true">
                <path fill="currentColor" d="M12 2L1 21h22L12 2zm0 3.5L20.3 19H3.7L12 5.5zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z" />
            </svg>
            <strong>@Localizer["DemoBannerTitle"]</strong>
        </div>
        <div class="demo-security-banner__text">
            <span class="demo-security-banner__warning">@Localizer["DemoBannerWarning"]</span>
            <span class="demo-security-banner__disclaimer">@Localizer["DemoBannerDisclaimer"]</span>
        </div>
    </div>
</aside>
