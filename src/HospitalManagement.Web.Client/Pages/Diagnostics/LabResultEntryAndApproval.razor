    }

    private async Task SubmitCorrectionAsync()
    {
        if (_selectedResult == null || string.IsNullOrWhiteSpace(_correctionReason)) return;
        _isSaving = true;
        _errorMessage = null;

        try
        {
            var req = new CorrectLabResultRequest
            {
                CorrectionReason = _correctionReason.Trim(),
                CorrectedItems = _correctionItems.Select(i => new LabResultItemValueRequest
                {
                    ParameterCode = i.ParameterCode,
                    NumericValue = i.NumericValue,
                    StringValue = i.StringValue,
                    Notes = i.Notes,
                }).ToList(),
            };

            var corrected = await DiagnosticsApi.CorrectLabResultAsync(_selectedResult.Id, req);
            if (corrected != null)
            {
                _showCorrectionModal = false;
                _selectedResult = corrected;
                _successMessage = "Düzeltme başarıyla kaydedildi ve yeni sonuç oluşturuldu.";
                await LoadWorklistAsync();
            }
            else
            {
                _errorMessage = "Düzeltme işlemi gerçekleştirilemedi.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Sonuç düzeltmesi kaydedilemedi. Bilgileri kontrol edip yeniden deneyin.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Draft" => "bg-secondary text-white",
        "TechnicallyApproved" => "bg-info text-white",
        "FinalApproved" => "bg-success text-white",
        "Corrected" => "bg-primary text-white",
        "Cancelled" => "bg-dark text-white",
        "EnteredInError" => "bg-danger text-white",
        _ => "bg-light text-dark",
    };

    private static string GetStatusText(string status) => status switch
    {
        "Draft" => "Taslak",
        "TechnicallyApproved" => "Teknik Onaylı",
        "FinalApproved" => "Kesinleşmiş (Onaylı)",
        "Corrected" => "Düzeltilmiş",
        "Cancelled" => "İptal Edildi",
        "EnteredInError" => "Hatalı Giriş",
        _ => status,
    };

    private static string GetFlagBadgeClass(string flag) => flag switch
