        "Low" => "bg-warning-subtle text-warning-emphasis border border-warning",
        "High" => "bg-warning-subtle text-warning-emphasis border border-warning",
        "CriticalLow" => "bg-danger text-white",
        "CriticalHigh" => "bg-danger text-white",
        "Abnormal" => "bg-danger-subtle text-danger border border-danger",
        _ => "bg-light text-secondary",
    };

    private static string GetFlagText(string flag) => flag switch
