@page "/diagnostics/blood-bank"
@using HospitalManagement.Contracts.Diagnostics
@using HospitalManagement.Web.Client.Diagnostics
@inject IDiagnosticsApiClient DiagnosticsApi
@inject NavigationManager Navigation

<PageTitle>Kan Bankası ve İmmünohematoloji - Hastane Yönetim Sistemi</PageTitle>

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 text-danger fw-bold">
                <i class="bi bi-droplet-fill me-2"></i>Kan Bankası ve İmmünohematoloji
            </h4>
            <p class="text-muted small mb-0">Kan ürünü stok takibi, crossmatch uygunluk testi ve transfüzyon yönetimi</p>
        </div>
        <div>
            <button class="btn btn-outline-danger btn-sm me-2" @onclick="RefreshDataAsync">
                <i class="bi bi-arrow-clockwise me-1"></i>Yenile
            </button>
        </div>
    </div>

    <!-- Demo Banner -->
    <div class="alert alert-warning d-flex align-items-center mb-4 py-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2"></i>
        <div class="small">
            <strong>DEMO / SİMÜLASYON:</strong> Bu ekran sentetik kan bankası ve deterministik crossmatch simülasyonu ile çalışmaktadır. Gerçek klinik transfüzyon kararı için kullanılamaz.
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-x-circle-fill me-2"></i>@_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    <!-- Summary Metrics -->
    @if (_summary != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-2 col-sm-4">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="text-muted small">Toplam Ünite</div>
                    <div class="fs-4 fw-bold text-dark">@_summary.TotalUnits</div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="text-muted small">Müsait Stok</div>
                    <div class="fs-4 fw-bold text-success">@_summary.AvailableUnits</div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="text-muted small">Rezerve</div>
                    <div class="fs-4 fw-bold text-primary">@_summary.ReservedUnits</div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="text-muted small">Kliniğe Çıkan</div>
                    <div class="fs-4 fw-bold text-warning">@_summary.IssuedUnits</div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="text-muted small">Transfüzyon</div>
                    <div class="fs-4 fw-bold text-info">@_summary.TransfusedUnits</div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="text-muted small">İmha / Fire</div>
                    <div class="fs-4 fw-bold text-danger">@_summary.DiscardedUnits</div>
                </div>
            </div>
        </div>
    }

    <!-- Tabs for Inventory vs Crossmatch Worklist -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "inventory" ? "active fw-bold" : "")" @onclick='() => _activeTab = "inventory"'>
                <i class="bi bi-box-seam me-1"></i>Kan Ürünü Stokları (@_units.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "crossmatch" ? "active fw-bold" : "")" @onclick='() => _activeTab = "crossmatch"'>
                <i class="bi bi-shield-check me-1"></i>Crossmatch & Uygunluk İş Listesi (@_crossmatches.Count)
            </button>
        </li>
    </ul>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <div class="text-muted mt-2">Kan bankası verileri yükleniyor...</div>
        </div>
    }
    else if (_activeTab == "inventory")
    {
        <!-- Inventory Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ünite No</th>
                                <th>Ürün Tipi</th>
                                <th>Kan Grubu</th>
                                <th>Hacim (ml)</th>
                                <th>Son Kullanma</th>
                                <th>Saklama Yeri</th>
                                <th>Durum</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_units.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">Kayıtlı kan ürünü ünitesi bulunamadı.</td>
                                </tr>
                            }
                            @foreach (var unit in _units)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-light text-dark font-monospace border">@unit.UnitNumber</span>
                                    </td>
                                    <td>@GetProductTypeName(unit.ProductType)</td>
                                    <td>
                                        <span class="badge bg-danger">@GetBloodGroupName(unit.BloodGroup)</span>
                                    </td>
                                    <td>@unit.VolumeMl ml</td>
                                    <td>
                                        @{
                                            var isExpiringSoon = (unit.ExpiryDateUtc - DateTime.UtcNow).TotalDays < 5;
                                        }
                                        <span class="@(isExpiringSoon ? "text-danger fw-bold" : "")">
                                            @unit.ExpiryDateUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </span>
                                    </td>
                                    <td><small class="text-muted">@unit.StorageLocation</small></td>
                                    <td>@RenderUnitStatusBadge(unit.Status)</td>
                                    <td class="text-end">
                                        @if (unit.Status == "Reserved" || unit.Status == "Available")
                                        {
                                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => IssueUnitAsync(unit.Id)">
                                                <i class="bi bi-box-arrow-right me-1"></i>Çıkış Yap
                                            </button>
                                        }
                                        @if (unit.Status == "Issued")
                                        {
                                            <button class="btn btn-outline-success btn-sm" @onclick="() => TransfuseUnitAsync(unit.Id)">
                                                <i class="bi bi-heart-pulse me-1"></i>Transfüzyon
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Crossmatch Worklist Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kayıt Tarihi</th>
                                <th>Hasta ID</th>
                                <th>Hasta Grubu</th>
                                <th>Talep Edilen Ürün</th>
                                <th>Miktar</th>
                                <th>Crossmatch Durumu</th>
                                <th>Uygunluk Sonucu</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_crossmatches.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">Bekleyen crossmatch veya kan ürünü talebi bulunamadı.</td>
                                </tr>
                            }
                            @foreach (var cm in _crossmatches)
                            {
                                <tr>
                                    <td>@cm.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><span class="font-monospace small">@cm.PatientId.ToString().Substring(0, 8)...</span></td>
                                    <td><span class="badge bg-danger">@GetBloodGroupName(cm.PatientBloodGroup)</span></td>
                                    <td>@GetProductTypeName(cm.RequestedProductType)</td>
                                    <td>@cm.UnitsRequested Ünite</td>
                                    <td>@RenderCrossmatchStatusBadge(cm.Status)</td>
                                    <td>@RenderCompatibilityBadge(cm.CompatibilityResult)</td>
                                    <td class="text-end">
                                        @if (cm.Status == "Requested")
                                        {
                                            <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenCrossmatchModal(cm)">
                                                <i class="bi bi-eyedropper me-1"></i>Test Uygula
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Crossmatch Test Application -->
@if (_selectedCrossmatch != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-shield-check me-2"></i>Crossmatch Uygunluk Testi Simülasyonu
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _selectedCrossmatch = null"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border mb-3">
                        <div><strong>Hasta Kan Grubu:</strong> @GetBloodGroupName(_selectedCrossmatch.PatientBloodGroup)</div>
                        <div><strong>Talep Edilen Ürün:</strong> @GetProductTypeName(_selectedCrossmatch.RequestedProductType) (@_selectedCrossmatch.UnitsRequested Ünite)</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Test Edilecek Stok Ünitesi:</label>
                        <select class="form-select" @bind="_selectedUnitId">
                            <option value="">-- Kan Ünitesi Seçiniz --</option>
                            @foreach (var u in _units.Where(u => u.Status == "Available"))
                            {
                                <option value="@u.Id">@u.UnitNumber - @GetBloodGroupName(u.BloodGroup) (@GetProductTypeName(u.ProductType)) - Son Kul: @u.ExpiryDateUtc.ToString("dd.MM.yyyy")</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Laboratuvar / Teknisyen Notu:</label>
                        <textarea class="form-control" rows="2" @bind="_technicianNotes" placeholder="Serolojik ve jel santrifügasyon yöntemi uygulandı."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _selectedCrossmatch = null">Vazgeç</button>
                    <button type="button" class="btn btn-danger" @onclick="SubmitCrossmatchTestAsync">
                        <i class="bi bi-check2-circle me-1"></i>Crossmatch Testini Tamamla
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private string _activeTab = "inventory";
    private string? _errorMessage;
    private string? _successMessage;

    private BloodInventorySummaryResponse? _summary;
    private List<BloodUnitResponse> _units = [];
    private List<CrossmatchSummaryResponse> _crossmatches = [];

    private CrossmatchSummaryResponse? _selectedCrossmatch;
    private Guid? _selectedUnitId;
    private string _technicianNotes = "Bilgisayarlı ve serolojik crossmatch testi uygulandı.";

    protected override async Task OnInitializedAsync()
    {
        await RefreshDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _summary = await DiagnosticsApi.GetBloodInventorySummaryAsync();
            _units = await DiagnosticsApi.GetBloodInventoryAsync();
            _crossmatches = await DiagnosticsApi.GetCrossmatchWorklistAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Kan bankası verileri yüklenemedi. Lütfen yeniden deneyin.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCrossmatchModal(CrossmatchSummaryResponse cm)
    {
        _selectedCrossmatch = cm;
        _selectedUnitId = null;
        _technicianNotes = "Bilgisayarlı ve serolojik crossmatch testi uygulandı.";
    }

    private async Task SubmitCrossmatchTestAsync()
    {
        if (_selectedCrossmatch == null || _selectedUnitId == null || _selectedUnitId == Guid.Empty)
        {
            _errorMessage = "Lütfen test edilecek kan ünitesini seçiniz.";
            return;
        }

        try
        {
            var req = new PerformCrossmatchRequestDto
            {
                BloodUnitId = _selectedUnitId.Value,
                TechnicianNotes = _technicianNotes,
            };

            var res = await DiagnosticsApi.PerformCrossmatchTestAsync(_selectedCrossmatch.Id, req);
            if (res != null)
            {
                if (res.CompatibilityResult == "Incompatible")
                {
                    _errorMessage = "UYUMSUZLUK: Seçilen kan ünitesi hasta ile uyumsuz bulundu (Incompatible). Ünite tahsis edilmedi.";
                }
                else
                {
                    _successMessage = "Crossmatch testi başarıyla tamamlandı ve kan ünitesi rezerve edildi.";
                }
            }
            _selectedCrossmatch = null;
            await RefreshDataAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Uygunluk işlemi tamamlanamadı. Bilgileri kontrol edip yeniden deneyin.";
        }
    }

    private async Task IssueUnitAsync(Guid unitId)
    {
        try
        {
            var res = await DiagnosticsApi.IssueBloodUnitAsync(unitId);
            if (res != null)
            {
                _successMessage = $"Ünite çıkışı ({res.UnitNumber}) kliniğe yapıldı.";
                await RefreshDataAsync();
            }
        }
        catch (Exception)
        {
            _errorMessage = "Kan ürünü çıkışı tamamlanamadı. Lütfen yeniden deneyin.";
        }
    }

    private async Task TransfuseUnitAsync(Guid unitId)
    {
        try
        {
            var res = await DiagnosticsApi.RecordTransfusionAsync(unitId);
            if (res != null)
            {
                _successMessage = $"Transfüzyon işlemi ({res.UnitNumber}) başarıyla kaydedildi.";
                await RefreshDataAsync();
            }
        }
        catch (Exception)
        {
            _errorMessage = "Transfüzyon kaydı tamamlanamadı. Lütfen yeniden deneyin.";
        }
    }

    private static string GetBloodGroupName(string group) => group switch
    {
        "APositive" => "A Rh(+)",
        "ANegative" => "A Rh(-)",
        "BPositive" => "B Rh(+)",
        "BNegative" => "B Rh(-)",
        "ABPositive" => "AB Rh(+)",
        "ABNegative" => "AB Rh(-)",
        "OPositive" => "0 Rh(+)",
        "ONegative" => "0 Rh(-)",
        _ => group,
    };

    private static string GetProductTypeName(string type) => type switch
    {
        "RedBloodCells" => "Eritrosit Süspansiyonu",
        "FreshFrozenPlasma" => "Taze Donmuş Plazma (TDP)",
        "Platelets" => "Trombosit Süspansiyonu",
        "Cryoprecipitate" => "Kriyopresipitat",
        "WholeBlood" => "Tam Kan",
        _ => type,
    };

    private static RenderFragment RenderUnitStatusBadge(string status) => builder =>
    {
        var (cssClass, text) = status switch
        {
            "Available" => ("bg-success", "Müsait"),
            "Reserved" => ("bg-primary", "Rezerve"),
            "Issued" => ("bg-warning text-dark", "Kliniğe Çıktı"),
            "Transfused" => ("bg-info text-dark", "Transfüzyon Yapıldı"),
            "Discarded" => ("bg-danger", "İmha Edildi"),
            _ => ("bg-secondary", status),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cssClass}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    private static RenderFragment RenderCrossmatchStatusBadge(string status) => builder =>
    {
        var (cssClass, text) = status switch
        {
            "Requested" => ("bg-warning text-dark", "Test Bekliyor"),
            "Completed" => ("bg-success", "Tamamlandı"),
            "Cancelled" => ("bg-danger", "İptal"),
            _ => ("bg-secondary", status),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cssClass}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    private static RenderFragment RenderCompatibilityBadge(string comp) => builder =>
    {
        var (cssClass, text) = comp switch
        {
            "Compatible" => ("bg-success", "Uyumlu (Compatible)"),
            "Incompatible" => ("bg-danger", "Uyumsuz (Incompatible)"),
            _ => ("bg-secondary", "Test Edilmedi"),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cssClass}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };
}
