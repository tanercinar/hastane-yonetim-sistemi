        "GrossExamCompleted" => "Makroskopi Bitti",
        "MicroscopicExamCompleted" => "Mikroskopi Bitti",
        "ReportDrafted" => "Taslak Rapor",
        "ReportFinalized" => "Rapor Kesinleşti",
