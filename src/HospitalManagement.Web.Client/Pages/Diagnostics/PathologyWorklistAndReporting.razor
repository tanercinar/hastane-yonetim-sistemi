    private async Task OpenCorrectionModal(Guid id)
    {
        _activeCaseDetail = await DiagnosticsApi.GetPathologyCaseByIdAsync(id);
        if (_activeCaseDetail != null)
        {
            _correctionReason = null;
            _newDiagnosis = _activeCaseDetail.PathologicalDiagnosis;
            _showCorrectionModal = true;
        }
    }

    private async Task SubmitCorrectionAsync()
    {
        if (_activeCaseDetail == null || string.IsNullOrWhiteSpace(_correctionReason) || string.IsNullOrWhiteSpace(_newDiagnosis)) return;
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var req = new CorrectPathologyReportRequest
            {
                CorrectionReason = _correctionReason.Trim(),
                NewDiagnosis = _newDiagnosis.Trim(),
            };
            var updated = await DiagnosticsApi.CorrectPathologyReportAsync(_activeCaseDetail.Id, req);
            if (updated != null)
            {
                _showCorrectionModal = false;
                _successMessage = "Düzeltilmiş patoloji raporu başarıyla yayınlandı.";
                await LoadCasesAsync();
            }
            else
            {
                _errorMessage = "Düzeltme kaydedilemedi.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Patoloji raporu düzeltmesi kaydedilemedi. Lütfen yeniden deneyin.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string GetSpecimenTypeText(string type) => type switch
    {
        "Biopsy" => "Biyopsi",
        "Excision" => "Eksizyon",
        "Cytology" => "Sitoloji",
        "FrozenSection" => "Frozen Kesit",
        "Resection" => "Rezeksiyon",
        _ => type,
    };

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Ordered" => "bg-secondary text-white",
        "SpecimenReceived" => "bg-info text-white",
        "GrossExamCompleted" => "bg-primary text-white",
        "MicroscopicExamCompleted" => "bg-indigo text-white bg-dark",
        "ReportDrafted" => "bg-warning text-dark",
        "ReportFinalized" => "bg-success text-white",
        "Corrected" => "bg-success-subtle text-success border border-success",
        "Cancelled" => "bg-danger text-white",
        _ => "bg-light text-dark",
    };

