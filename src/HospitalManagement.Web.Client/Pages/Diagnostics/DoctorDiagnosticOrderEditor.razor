@using HospitalManagement.Contracts.Diagnostics
@using HospitalManagement.Web.Client.Diagnostics
@inject IDiagnosticsApiClient DiagnosticsApi

<div class="card shadow-sm border-0 mb-4" data-testid="doctor-diagnostic-order-editor">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
        <h5 class="mb-0 fs-6">
            <i class="bi bi-clipboard2-pulse me-2"></i>Tanısal Tetkik İstem Paneli
        </h5>
        @if (IsReadOnly)
        {
            <span class="badge bg-light text-dark">
                <i class="bi bi-lock me-1"></i>Salt Okunur (Kilitli Karşılaşma)
            </span>
        }
    </div>
    <div class="card-body p-3">
        <!-- Demo Banner -->
        <div class="alert alert-warning py-1 px-2 d-flex align-items-center mb-3 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
            <div>
                <strong>EĞİTİM VE DEMO AMAÇLIDIR:</strong> Bu ekran gerçek hastane bilgi yönetim sistemi (HBYS) olmayıp sentetik test verisi üretir.
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i>@_errorMessage
                <button type="button" class="btn-close btn-sm" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
                <i class="bi bi-check-circle me-1"></i>@_successMessage
                <button type="button" class="btn-close btn-sm" @onclick="() => _successMessage = null"></button>
            </div>
        }

        @if (!IsReadOnly)
        {
            <div class="row g-3 mb-4">
                <!-- Test Search & Catalog Picker -->
                <div class="col-lg-6">
                    <div class="mb-2">
                        <label for="diagnostic-order-type" class="form-label fw-bold small mb-1">İstem Türü</label>
                        <select id="diagnostic-order-type"
                                data-testid="diagnostic-order-type"
                                class="form-select form-select-sm"
                                value="@_selectedOrderType"
                                @onchange="ChangeOrderTypeAsync">
                            <option value="Laboratory">Laboratuvar</option>
                            <option value="Radiology">Radyoloji</option>
                        </select>
                    </div>
                    <label for="diagnostic-catalog-search" class="form-label fw-bold small mb-1">@CatalogSearchLabel</label>
                    <div class="input-group input-group-sm mb-2">
                        <input id="diagnostic-catalog-search"
                               type="text"
                               class="form-control"
                               placeholder="@CatalogSearchPlaceholder"
                               @bind="_searchQuery"
                               @bind:event="oninput"
                               @onkeyup="OnSearchKeyUp" />
                        <button class="btn btn-outline-secondary" type="button" aria-label="Katalogda Ara" @onclick="SearchCatalogAsync">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <div class="list-group list-group-flush border rounded overflow-auto" style="max-height: 240px;">
                        @if (_isSearching)
                        {
                            <div class="p-3 text-center text-muted small">
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>Katalog taranıyor...
                            </div>
                        }
                        else if (_searchResults.Count == 0)
                        {
                            <div class="p-3 text-center text-muted small">
                                Arama kriterine uygun test bulunamadı.
                            </div>
                        }
                        else
                        {
                            @foreach (var item in _searchResults)
                            {
                                var isAdded = _selectedItems.Any(i => i.CatalogCode == item.Code);
                                <button type="button"
                                        aria-label="@($"{item.Name} isteme ekle")"
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-3 @(isAdded ? "disabled bg-light text-muted" : string.Empty)"
                                        @onclick="() => AddItemToOrder(item)">
                                    <div>
                                        <div class="fw-bold small">
                                            @item.Name
                                            @if (item.IsPanel)
                                            {
                                                <span class="badge bg-info text-dark ms-1">Panel (@item.ParameterCount test)</span>
                                            }
                                        </div>
                                        <div class="text-muted" style="font-size: 0.75rem;">
                                            <span class="me-2"><i class="bi bi-tag me-1"></i>@item.Category</span>
                                            <span class="me-2"><i class="bi @CatalogDetailIcon me-1"></i>@item.PrimaryDetail</span>
                                            <span><i class="bi bi-info-circle me-1"></i>@item.SecondaryDetail</span>
                                            @if (item.RequiresContrast)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">Kontrastlı</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="badge @(isAdded ? "bg-secondary" : "bg-primary") rounded-pill">
                                        @(isAdded ? "Eklendi" : "+ Ekle")
                                    </span>
                                </button>
                            }
                        }
                    </div>
                </div>

                <!-- Order Basket & Details -->
                <div class="col-lg-6">
                    <div class="card bg-light border-0 h-100 p-3">
                        <h6 class="fw-bold fs-7 mb-2 text-dark d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-basket me-1"></i>İstem Sepeti (@_selectedItems.Count Kalem)</span>
                            @if (_selectedItems.Count > 0)
                            {
                                <button class="btn btn-link btn-sm text-danger p-0 text-decoration-none" @onclick="ClearBasket">
                                    Tümünü Temizle
                                </button>
                            }
                        </h6>

                        @if (_selectedItems.Count == 0)
                        {
                            <div class="text-center text-muted my-auto py-4 small">
                                <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>
                                Henüz tetkik seçilmedi. Soldaki listeden tetkik ekleyin.
                            </div>
                        }
                        else
                        {
                            <div class="overflow-auto mb-2" style="max-height: 150px;">
                                <ul class="list-group list-group-flush rounded border">
                                    @foreach (var item in _selectedItems)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-1 px-2 small">
                                            <div>
                                                <div class="fw-bold">@item.CatalogItemName</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">@item.Category &bull; @item.CatalogCode</div>
                                            </div>
                                            <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Kaldır" @onclick="() => RemoveItemFromOrder(item.CatalogCode)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="row g-2 mt-auto">
                            <div class="col-sm-4">
                                <label class="form-label small fw-bold mb-0">Öncelik</label>
                                <select class="form-select form-select-sm" @bind="_selectedPriority">
                                    <option value="Routine">Rutin</option>
                                    <option value="Urgent">Acil (Urgent)</option>
                                    <option value="Stat">Kritik / STAT</option>
                                </select>
                            </div>
                            <div class="col-sm-8">
                                <label class="form-label small fw-bold mb-0">Ön Tanı / Klinik Gerekçe</label>
                                <input type="text" class="form-control form-control-sm" placeholder="Örn: Anemi tetkiki, preop..." @bind="_clinicalIndication" />
                            </div>
                            <div class="col-12">
                                <input type="text" class="form-control form-control-sm" placeholder="@OrderNotesPlaceholder" @bind="_orderNotes" />
                            </div>
                            <div class="col-12 text-end mt-2">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm me-2"
                                        disabled="@(_selectedItems.Count == 0 || _isSaving)"
                                        @onclick="() => SubmitOrderAsync(asDraft: true)">
                                    <i class="bi bi-file-earmark-text me-1"></i>Taslak Kaydet
                                </button>
                                <button type="button"
                                        class="btn btn-success btn-sm"
                                        disabled="@(_selectedItems.Count == 0 || _isSaving)"
                                        @onclick="() => SubmitOrderAsync(asDraft: false)">
                                    @if (_isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-send-check me-1"></i>
                                    }
                                    İstemi Onayla ve Gönder
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Existing Orders for this Encounter -->
        <h6 class="fw-bold fs-7 mb-2 text-dark">
            <i class="bi bi-clock-history me-1"></i>Bu Karşılaşmaya Ait Mevcut İstemler
        </h6>

        @if (_isLoadingOrders)
        {
            <div class="p-3 text-center text-muted small">
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>İstemler yükleniyor...
            </div>
        }
        else if (_encounterOrders.Count == 0)
        {
            <div class="alert alert-light border text-muted small mb-0 py-2">
                Bu karşılaşma için henüz kaydedilmiş bir tetkik istemi bulunmamaktadır.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle border small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>İstem No</th>
                            <th>Tür</th>
                            <th>Öncelik</th>
                            <th>Kalem Sayısı</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ord in _encounterOrders)
                        {
                            <tr>
                                <td class="fw-bold font-monospace">@ord.OrderNumber</td>
                                <td>@GetOrderTypeText(ord.OrderType)</td>
                                <td>
                                    @if (ord.Priority == "Stat")
                                    {
                                        <span class="badge bg-danger">STAT</span>
                                    }
                                    else if (ord.Priority == "Urgent")
                                    {
                                        <span class="badge bg-warning text-dark">Acil</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Rutin</span>
                                    }
                                </td>
                                <td>@ord.ItemCount Kalem</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(ord.Status)">@GetStatusText(ord.Status)</span>
                                </td>
                                <td>@ord.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    @if (!IsReadOnly && (ord.Status == "Draft" || ord.Status == "Placed"))
                                    {
                                        @if (ord.Status == "Draft")
                                        {
                                            <button class="btn btn-success btn-sm py-0 px-2 me-1"
                                                    title="İstemi Gönder"
                                                    @onclick="() => PlaceExistingOrderAsync(ord.Id, ord.OrderNumber)">
                                                <i class="bi bi-send-check me-1"></i>Gönder
                                            </button>
                                        }
                                        <button class="btn btn-outline-danger btn-sm py-0 px-2"
                                                title="İptal Et"
                                                @onclick="() => OpenCancelModal(ord.Id, ord.OrderNumber)">
                                            <i class="bi bi-x-circle me-1"></i>İptal
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Cancel Reason Modal -->
@if (_showCancelModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white py-2">
                    <h5 class="modal-title fs-6">İstem İptali — @_cancelOrderNumber</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showCancelModal = false"></button>
                </div>
                <div class="modal-body small">
                    <p class="mb-2 text-muted">İstemi iptal etmek için lütfen bir klinik gerekçe belirtin:</p>
                    <textarea class="form-control form-control-sm mb-2"
                              rows="3"
                              placeholder="Örn: Hasta tetkikten vazgeçti, klinik tanı revize edildi..."
                              @bind="_cancelReason"></textarea>
                    @if (!string.IsNullOrWhiteSpace(_cancelError))
                    {
                        <div class="text-danger small">@_cancelError</div>
                    }
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showCancelModal = false">Vazgeç</button>
                    <button type="button" class="btn btn-danger btn-sm" disabled="@_isCancelling" @onclick="ConfirmCancelOrderAsync">
                        @if (_isCancelling)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        İptali Onayla
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid EncounterId { get; set; }

    [Parameter]
    public Guid PatientId { get; set; }

    [Parameter]
    public Guid DepartmentId { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    private string _searchQuery = string.Empty;
    private bool _isSearching;
    private bool _isLoadingOrders;
    private bool _isSaving;
    private bool _isCancelling;

    private string? _errorMessage;
    private string? _successMessage;

    private List<DiagnosticCatalogOption> _searchResults = [];
    private readonly List<CreateDiagnosticOrderItemRequest> _selectedItems = [];
    private string _selectedOrderType = "Laboratory";
    private string _selectedPriority = "Routine";
    private string? _clinicalIndication;
    private string? _orderNotes;

    private List<DiagnosticOrderSummaryResponse> _encounterOrders = [];

    // Cancel modal state
    private bool _showCancelModal;
    private Guid _cancelOrderId;
    private string _cancelOrderNumber = string.Empty;
    private string _cancelReason = string.Empty;
    private string? _cancelError;

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogInitialAsync();
        await LoadEncounterOrdersAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadEncounterOrdersAsync();
    }

    private async Task LoadCatalogInitialAsync()
    {
        _isSearching = true;
        try
        {
            _searchResults = await LoadCatalogAsync(null, 20);
        }
        catch (Exception)
        {
            _errorMessage = "Katalog yüklenemedi. Lütfen bağlantınızı kontrol edip yeniden deneyin.";
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchCatalogAsync();
        }
    }

    private async Task SearchCatalogAsync()
    {
        _isSearching = true;
        try
        {
            _searchResults = await LoadCatalogAsync(_searchQuery, 30);
        }
        catch (Exception)
        {
            _errorMessage = "Katalog araması tamamlanamadı. Lütfen yeniden deneyin.";
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task LoadEncounterOrdersAsync()
    {
        if (EncounterId == Guid.Empty)
        {
            return;
        }

        _isLoadingOrders = true;
        try
        {
            _encounterOrders = await DiagnosticsApi.GetDiagnosticOrdersByEncounterAsync(EncounterId);
        }
        catch (Exception)
        {
            _errorMessage = "Mevcut istemler yüklenemedi. Lütfen yeniden deneyin.";
        }
        finally
        {
            _isLoadingOrders = false;
        }
    }

    private async Task ChangeOrderTypeAsync(ChangeEventArgs args)
    {
        var newType = args.Value?.ToString();
        if (newType is not ("Laboratory" or "Radiology") || newType == _selectedOrderType)
        {
            return;
        }

        _selectedOrderType = newType;
        _searchQuery = string.Empty;
        ClearBasket();
        _errorMessage = null;
        _successMessage = null;
        await LoadCatalogInitialAsync();
    }

    private async Task<List<DiagnosticCatalogOption>> LoadCatalogAsync(string? query, int maxResults)
    {
        if (_selectedOrderType == "Radiology")
        {
            var normalizedQuery = query?.Trim();
            var catalog = await DiagnosticsApi.GetRadiologyCatalogAsync();

            return catalog
                .Where(item => string.IsNullOrWhiteSpace(normalizedQuery)
                    || item.Code.Contains(normalizedQuery, StringComparison.OrdinalIgnoreCase)
                    || item.Name.Contains(normalizedQuery, StringComparison.OrdinalIgnoreCase)
                    || item.Modality.Contains(normalizedQuery, StringComparison.OrdinalIgnoreCase)
                    || item.BodySite.Contains(normalizedQuery, StringComparison.OrdinalIgnoreCase))
                .Take(maxResults)
                .Select(item => new DiagnosticCatalogOption(
                    item.Code,
                    item.Name,
                    item.Modality,
                    item.BodySite,
                    $"{item.EstimatedDurationMinutes} dakika",
                    false,
                    0,
                    item.ContrastRequired,
                    item.PreparationInstructions))
                .ToList();
        }

        var labCatalog = await DiagnosticsApi.SearchLabCatalogAsync(query, null, true, maxResults);
        return labCatalog
            .Select(item => new DiagnosticCatalogOption(
                item.Code,
                item.Name,
                item.Category,
                item.SpecimenType,
                item.ContainerType,
                item.IsPanel,
                item.ParameterCount,
                false,
                $"{item.SpecimenType} ({item.ContainerType})"))
            .ToList();
    }

    private void AddItemToOrder(DiagnosticCatalogOption item)
    {
        if (_selectedItems.Any(i => i.CatalogCode == item.Code))
        {
            return;
        }

        _selectedItems.Add(new CreateDiagnosticOrderItemRequest
        {
            CatalogCode = item.Code,
            CatalogItemName = item.Name,
            Category = item.Category,
            SpecialInstructions = item.SpecialInstructions,
        });
    }

    private void RemoveItemFromOrder(string catalogCode)
    {
        _selectedItems.RemoveAll(i => i.CatalogCode == catalogCode);
    }

    private void ClearBasket()
    {
        _selectedItems.Clear();
    }

    private async Task SubmitOrderAsync(bool asDraft)
    {
        if (_selectedItems.Count == 0)
        {
            _errorMessage = "Lütfen en az bir test kalemi ekleyin.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var draftReq = new CreateDiagnosticOrderDraftRequest
            {
                PatientId = PatientId,
                EncounterId = EncounterId,
                DepartmentId = DepartmentId,
                OrderType = _selectedOrderType,
                Priority = _selectedPriority,
                ClinicalIndication = _clinicalIndication,
                OrderNotes = _orderNotes,
                Items = _selectedItems,
            };

            var created = await DiagnosticsApi.CreateDiagnosticOrderDraftAsync(draftReq);
            if (created is null)
            {
                _errorMessage = "İstem oluşturulamadı. Lütfen bilgileri kontrol edin.";
                return;
            }

            if (!asDraft)
            {
                var placed = await DiagnosticsApi.PlaceDiagnosticOrderAsync(created.Id);
                if (placed is null)
                {
                    _errorMessage = "İstem taslağı oluşturuldu fakat onaylanamadı.";
                    return;
                }
                _successMessage = $"İstem ({created.OrderNumber}) başarıyla {TargetUnitText} iletildi.";
            }
            else
            {
                _successMessage = $"İstem taslağı ({created.OrderNumber}) kaydedildi.";
            }

            ClearBasket();
            _clinicalIndication = null;
            _orderNotes = null;
            await LoadEncounterOrdersAsync();
        }
        catch (Exception)
        {
            _errorMessage = "İstem işlemi tamamlanamadı. Bilgileri kontrol edip yeniden deneyin.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenCancelModal(Guid orderId, string orderNumber)
    {
        _cancelOrderId = orderId;
        _cancelOrderNumber = orderNumber;
        _cancelReason = string.Empty;
        _cancelError = null;
        _showCancelModal = true;
    }

    private async Task PlaceExistingOrderAsync(Guid orderId, string orderNumber)
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;
        try
        {
            var placed = await DiagnosticsApi.PlaceDiagnosticOrderAsync(orderId);
            if (placed is null)
            {
                _errorMessage = "Taslak istem gönderilemedi. İstem durumunu ve yetkinizi kontrol edin.";
                return;
            }

            _successMessage = $"İstem ({orderNumber}) başarıyla ilgili tanısal birime iletildi.";
            await LoadEncounterOrdersAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Taslak istem gönderilemedi. Lütfen yeniden deneyin.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ConfirmCancelOrderAsync()
    {
        if (string.IsNullOrWhiteSpace(_cancelReason))
        {
            _cancelError = "Lütfen bir iptal gerekçesi belirtin.";
            return;
        }

        _isCancelling = true;
        _cancelError = null;

        try
        {
            var res = await DiagnosticsApi.CancelDiagnosticOrderAsync(_cancelOrderId, new CancelDiagnosticOrderRequest
            {
                Reason = _cancelReason,
            });

            if (res is null)
            {
                _cancelError = "İstem iptal edilemedi.";
                return;
            }

            _showCancelModal = false;
            _successMessage = $"İstem ({_cancelOrderNumber}) iptal edildi.";
            await LoadEncounterOrdersAsync();
        }
        catch (Exception)
        {
            _cancelError = "İstem iptal edilemedi. Lütfen yeniden deneyin.";
        }
        finally
        {
            _isCancelling = false;
        }
    }

    private static string GetOrderTypeText(string orderType) => orderType switch
    {
        "Laboratory" => "Laboratuvar",
        "Radiology" => "Radyoloji",
        "Pathology" => "Patoloji",
        "BloodBank" => "Kan Bankası",
        _ => orderType,
    };

    private static string GetStatusText(string status) => status switch
    {
        "Draft" => "Taslak",
        "Placed" => "İletildi",
        "InProgress" => "İşlemde",
        "Completed" => "Tamamlandı",
        "Cancelled" => "İptal Edildi",
        "EnteredInError" => "Hatalı Giriş",
        _ => status,
    };

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Draft" => "bg-secondary",
        "Placed" => "bg-primary",
        "InProgress" => "bg-info text-dark",
        "Completed" => "bg-success",
        "Cancelled" => "bg-danger",
        "EnteredInError" => "bg-dark",
        _ => "bg-secondary",
    };

    private string CatalogSearchLabel => _selectedOrderType == "Radiology"
        ? "Radyoloji Tetkiki Ara"
        : "Laboratuvar Testi veya Paneli Ara";

    private string CatalogSearchPlaceholder => _selectedOrderType == "Radiology"
        ? "Tetkik adı, kod, modalite veya bölge (Örn: Akciğer, CT, MR)..."
        : "Test adı, kod (Örn: Hemogram, Biyokimya, CBC, Glukoz)...";

    private string CatalogDetailIcon => _selectedOrderType == "Radiology" ? "bi-person-bounding-box" : "bi-eyedropper";

    private string OrderNotesPlaceholder => _selectedOrderType == "Radiology"
        ? "Radyoloji hazırlığı, kontrast veya çekim notu..."
        : "Laboratuvar için özel hazırlık/numune notu...";

    private string TargetUnitText => _selectedOrderType == "Radiology" ? "radyoloji birimine" : "laboratuvara";

    private sealed record DiagnosticCatalogOption(
        string Code,
        string Name,
        string Category,
        string PrimaryDetail,
        string SecondaryDetail,
        bool IsPanel,
        int ParameterCount,
        bool RequiresContrast,
        string? SpecialInstructions);
}
