@page "/account/login"
@page "/login"
@inject IdentityApiClient Identity
@inject UserSessionState SessionState
@inject NavigationManager Navigation

<PageTitle>DEMO Giriş Portalı</PageTitle>

<section class="account-shell" aria-labelledby="login-heading">
    <header class="account-shell__heading">
        <span class="page-eyebrow">Güvenli Oturum</span>
        <h1 id="login-heading">Hastane Yönetim Portalı</h1>
        <p>Rolünüze uygun hesaba giriş yapın. Giriş sonrası otomatik olarak yetkili ekranınıza yönlendirileceksiniz.</p>
    </header>

    @if (_isCheckingSession)
    {
        <p role="status" style="text-align:center; padding:1.5rem; color:#64748b;">Mevcut oturum doğrulanıyor…</p>
    }
    else if (SessionState.IsAuthenticated)
    {
        <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:0.5rem; padding:1.25rem; margin-bottom:1.5rem; text-align:center;">
            <p style="margin:0 0 0.5rem 0; font-weight:600; color:#166534;">Zaten giriş yapmış durumdasınız.</p>
            <p style="margin:0 0 1rem 0; font-size:0.9rem; color:#15803d;">
                <strong>@SessionState.Email</strong> (@SessionState.GetRoleDisplayName()) olarak oturumunuz açık.
            </p>
            <div style="display:flex; gap:0.5rem; justify-content:center;">
                <button class="ui-button ui-button--primary" type="button" @onclick="GoToDashboard">Çalışma Alanıma Git</button>
                <button class="ui-button ui-button--secondary" type="button" @onclick="LogoutAsync">Farklı Hesapla Giriş Yap</button>
            </div>
        </div>
    }
    else
    {
        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:0.5rem; padding:1rem; margin-bottom:1.5rem;">
            <span style="display:block; font-size:0.8rem; font-weight:700; color:#475569; margin-bottom:0.5rem; text-transform:uppercase; letter-spacing:0.05em;">Hızlı Demo Girişi (Tek Tıkla Doldur)</span>
            <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
                <button type="button" class="ui-button ui-button--secondary" style="font-size:0.8rem; padding:0.35rem 0.6rem;" @onclick="@(() => FillDemo("DEMO-patient@hospital.invalid", "DEMO-Patient-Pass!1"))">
                    🩺 Demo Hasta
                </button>
                <button type="button" class="ui-button ui-button--secondary" style="font-size:0.8rem; padding:0.35rem 0.6rem;" @onclick="@(() => FillDemo("DEMO-doctor@hospital.invalid", "DEMO-Doc-Pass!1"))">
                    👨‍⚕️ Demo Hekim
                </button>
                <button type="button" class="ui-button ui-button--secondary" style="font-size:0.8rem; padding:0.35rem 0.6rem;" @onclick="@(() => FillDemo("DEMO-receptionist@hospital.invalid", "DEMO-Recep-Pass!1"))">
                    📋 Demo Kayıt Masası
                </button>
                <button type="button" class="ui-button ui-button--secondary" style="font-size:0.8rem; padding:0.35rem 0.6rem;" @onclick="@(() => FillDemo("DEMO-admin@hospital.invalid", "DEMO-Admin-Pass!1"))">
                    ⚙️ Demo Yönetici
                </button>
            </div>
        </div>

        <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="account-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <label for="login-email">DEMO e-posta</label>
            <InputText id="login-email" @bind-Value="_model.Email" autocomplete="email" placeholder="ornek@hospital.invalid" />
            
            <label for="login-password">Parola</label>
            <InputText id="login-password" @bind-Value="_model.Password" type="password" autocomplete="current-password" placeholder="••••••••" />
            
            <button class="ui-button ui-button--primary" type="submit" disabled="@_isSubmitting" style="margin-top:0.75rem;">
                @(_isSubmitting ? "Giriş yapılıyor…" : "Giriş yap")
            </button>
        </EditForm>

        @if (_message is not null)
        {
            <p class="account-message account-message--error" role="alert" style="margin-top:1rem;">@_message</p>
        }

        <nav class="account-links" aria-label="Hesap işlemleri" style="margin-top:1.5rem;">
            <a href="account/register">Yeni Hasta Hesabı Oluştur</a>
            <a href="account/forgot-password">Parolamı Unuttum</a>
            <a href="account/accept-staff-invitation">Personel Davetim Var</a>
        </nav>
    }
</section>

@code {
    private readonly LoginModel _model = new();
    private bool _isSubmitting;
    private bool _isCheckingSession = true;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await SessionState.EnsureLoadedAsync();
        _isCheckingSession = false;

        if (SessionState.IsAuthenticated)
        {
            // If already authenticated, redirect to role dashboard automatically
            Navigation.NavigateTo(SessionState.GetHomeRouteForCurrentRole());
        }
    }

    private void FillDemo(string email, string password)
    {
        _model.Email = email;
        _model.Password = password;
        _message = null;
    }

    private void GoToDashboard()
    {
        Navigation.NavigateTo(SessionState.GetHomeRouteForCurrentRole());
    }

    private async Task LogoutAsync()
    {
        await SessionState.LogoutAsync();
    }

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _message = null;
        try
        {
            var result = await Identity.LoginAsync(new LoginRequest
            {
                Email = _model.Email,
                Password = _model.Password,
            });
            if (result.Succeeded)
            {
                if (result.RequiresTwoFactor)
                {
                    Navigation.NavigateTo("account/two-factor");
                    return;
                }

                await SessionState.EnsureLoadedAsync(forceRefresh: true);
                var targetRoute = SessionState.GetHomeRouteForCurrentRole();
                Navigation.NavigateTo(targetRoute);
                return;
            }

            _message = result.Message;
        }
        catch (OperationCanceledException)
        {
            _message = "Giriş isteği zaman aşımına uğradı. Lütfen tekrar deneyin.";
        }
        catch (Exception)
        {
            _message = "Sunucuya güvenli bağlantı kurulamadı. Yerel altyapının ve HTTPS adresinin çalıştığını kontrol edin.";
        }
        finally
        {
            _model.Password = string.Empty;
            _isSubmitting = false;
        }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "E-posta zorunludur.")]
        [EmailAddress(ErrorMessage = "Geçerli bir e-posta girin.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Parola zorunludur.")]
        public string Password { get; set; } = string.Empty;
    }
}
