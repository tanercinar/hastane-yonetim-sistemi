@page "/account/forgot-password"
@inject IdentityApiClient Identity

<PageTitle>DEMO parola sıfırlama isteği</PageTitle>

<section class="account-shell" aria-labelledby="forgot-heading">
    <header class="account-shell__heading">
        <span class="page-eyebrow">Hesap kurtarma</span>
        <h1 id="forgot-heading">Parola sıfırlama kodu iste</h1>
        <p>Hesabın varlığı açıklanmaz; uygun hesap için kod MOCK teslim kanalına gönderilir.</p>
    </header>
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="account-form">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <label for="forgot-email">DEMO e-posta</label>
        <InputText id="forgot-email" @bind-Value="_model.Email" autocomplete="email" />
        <button class="ui-button ui-button--primary" type="submit" disabled="@_isSubmitting">
            @(_isSubmitting ? "Gönderiliyor…" : "Kod iste")
        </button>
    </EditForm>
    @if (_message is not null)
    {
        <p class="account-message @(_succeeded ? "account-message--success" : "account-message--error")"
           role="@(_succeeded ? "status" : "alert")">@_message</p>
    }
    <nav class="account-links" aria-label="Hesap işlemleri">
        <a href="account/reset-password">Sıfırlama kodunu gir</a>
        <a href="account/login">Giriş ekranına dön</a>
    </nav>
</section>

@code {
    private readonly EmailModel _model = new();
    private bool _isSubmitting;
    private bool _succeeded;
    private string? _message;

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        try
        {
            var result = await Identity.RequestPasswordResetAsync(new RequestPasswordResetRequest
            {
                Email = _model.Email,
            });
            _succeeded = result.Succeeded;
            _message = result.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class EmailModel
    {
        [Required(ErrorMessage = "E-posta zorunludur.")]
        [EmailAddress(ErrorMessage = "Geçerli bir e-posta girin.")]
        public string Email { get; set; } = string.Empty;
    }
}
