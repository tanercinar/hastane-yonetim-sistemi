@page "/reporting/diagnostics"
@using HospitalManagement.Contracts.Reporting
@using HospitalManagement.Web.Client.Identity
@using HospitalManagement.Web.Client.Reporting
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IReportingApiClient ReportingClient
@inject UserSessionState SessionState

<PageTitle>Tanısal Hizmetler Panosu — HMS</PageTitle>

<div class="ui-container" style="max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--color-text-main); margin: 0;">Tanısal Hizmetler Operasyon Panosu</h1>
            <p style="font-size: 0.875rem; color: var(--color-text-muted); margin: 0.25rem 0 0 0;">
                Laboratuvar ve radyoloji iş yükü, numune ve sonuç süreçleri, kritik sonuç takibi
            </p>
        </div>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <input type="date" class="ui-input" style="width: auto;" @bind="SelectedDate" @bind:after="LoadDashboardAsync" />
            <button type="button" class="ui-button ui-button--secondary" @onclick="LoadDashboardAsync" disabled="@IsLoading">
                Yenile
            </button>
        </div>
    </div>

    @if (IsForbidden)
    {
        <div class="ui-card" style="padding: 2rem; text-align: center; border-left: 4px solid var(--color-danger);">
            <h2 style="font-size: 1.125rem; font-weight: 600; color: var(--color-danger); margin: 0 0 0.5rem 0;">Erişim Yetkisi Yok</h2>
            <p style="color: var(--color-text-muted); margin: 0;">Bu operasyon panosunu görüntülemek için gereken yetkiye sahip değilsiniz.</p>
        </div>
    }
    else if (IsLoading)
    {
        <div class="ui-card" style="padding: 3rem; text-align: center;">
            <div class="ui-spinner" style="margin: 0 auto 1rem auto;"></div>
            <p style="color: var(--color-text-muted); margin: 0;">Tanısal metrikler yükleniyor...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="ui-card" style="padding: 2rem; text-align: center; border-left: 4px solid var(--color-danger);">
            <h2 style="font-size: 1.125rem; font-weight: 600; color: var(--color-danger); margin: 0 0 0.5rem 0;">Hata Oluştu</h2>
            <p style="color: var(--color-text-muted); margin: 0 0 1rem 0;">@ErrorMessage</p>
            <button type="button" class="ui-button ui-button--primary" @onclick="LoadDashboardAsync">Tekrar Dene</button>
        </div>
    }
    else if (Summary is null || Summary.TotalOrders == 0)
    {
        <div class="ui-card" style="padding: 3rem; text-align: center;">
            <h2 style="font-size: 1.125rem; font-weight: 600; color: var(--color-text-main); margin: 0 0 0.5rem 0;">Seçili Günde Tanısal İstem Yok</h2>
            <p style="color: var(--color-text-muted); margin: 0;">@SelectedDate.ToString("dd.MM.yyyy") tarihi için kayıtlı tanısal tetkik/rapor verisi bulunamadı.</p>
        </div>
    }
    else
    {
        <!-- KPI Summary Cards -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
            <div class="ui-card" style="padding: 1.25rem;">
                <span style="font-size: 0.75rem; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase;">Toplam İstem</span>
                <div style="font-size: 1.75rem; font-weight: 700; color: var(--color-text-main); margin-top: 0.25rem;">@Summary.TotalOrders</div>
            </div>
            <div class="ui-card" style="padding: 1.25rem;">
                <span style="font-size: 0.75rem; font-weight: 600; color: var(--color-warning); text-transform: uppercase;">Bekleyen Numune</span>
                <div style="font-size: 1.75rem; font-weight: 700; color: var(--color-warning); margin-top: 0.25rem;">@Summary.PendingSpecimenCount</div>
            </div>
            <div class="ui-card" style="padding: 1.25rem;">
                <span style="font-size: 0.75rem; font-weight: 600; color: #3b82f6; text-transform: uppercase;">İşlemde / Cihazda</span>
                <div style="font-size: 1.75rem; font-weight: 700; color: #3b82f6; margin-top: 0.25rem;">@Summary.ProcessingCount</div>
            </div>
            <div class="ui-card" style="padding: 1.25rem;">
                <span style="font-size: 0.75rem; font-weight: 600; color: var(--color-success); text-transform: uppercase;">Sonuçlanan / Onaylı</span>
                <div style="font-size: 1.75rem; font-weight: 700; color: var(--color-success); margin-top: 0.25rem;">@Summary.FinalizedCount</div>
            </div>
            <div class="ui-card" style="padding: 1.25rem;">
                <span style="font-size: 0.75rem; font-weight: 600; color: var(--color-danger); text-transform: uppercase;">Kritik Sonuç</span>
                <div style="font-size: 1.75rem; font-weight: 700; color: var(--color-danger); margin-top: 0.25rem;">@Summary.CriticalCount</div>
            </div>
            <div class="ui-card" style="padding: 1.25rem;">
                <span style="font-size: 0.75rem; font-weight: 600; color: var(--color-primary); text-transform: uppercase;">Ort. TAT Süresi</span>
                <div style="font-size: 1.75rem; font-weight: 700; color: var(--color-primary); margin-top: 0.25rem;">@(Summary.AvgTurnaroundMinutes > 0 ? $"{Summary.AvgTurnaroundMinutes} dk" : "—")</div>
            </div>
        </div>

        <!-- Modality Breakdown Table -->
        <div class="ui-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
            <h2 style="font-size: 1.125rem; font-weight: 600; margin: 0 0 1rem 0;">Bölüm / Modalite Bazlı Dağılım</h2>
            <div style="overflow-x: auto;">
                <table class="ui-table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th>Birim / Modalite</th>
                            <th style="text-align: right;">Toplam İstem</th>
                            <th style="text-align: right;">Bekleyen Numune</th>
                            <th style="text-align: right;">İşlemde</th>
                            <th style="text-align: right;">Sonuçlanan</th>
                            <th style="text-align: right;">Kritik Sonuç</th>
                            <th style="text-align: right;">Ortalama Süre (TAT)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mod in ModalityMetrics)
                        {
                            <tr>
                                <td style="font-weight: 500;">@mod.ModalityOrSection</td>
                                <td style="text-align: right; font-weight: 600;">@mod.TotalOrders</td>
                                <td style="text-align: right; color: var(--color-warning);">@mod.PendingSpecimenCount</td>
                                <td style="text-align: right; color: #3b82f6;">@mod.ProcessingCount</td>
                                <td style="text-align: right; color: var(--color-success); font-weight: 600;">@mod.FinalizedCount</td>
                                <td style="text-align: right; color: var(--color-danger); font-weight: 600;">@mod.CriticalCount</td>
                                <td style="text-align: right; font-weight: 500;">@(mod.AvgTurnaroundMinutes > 0 ? $"{mod.AvgTurnaroundMinutes} dk" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Critical Alerts Panel -->
        @if (CriticalAlerts.Count > 0)
        {
            <div class="ui-card" style="padding: 1.5rem; border-left: 4px solid var(--color-danger);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <h2 style="font-size: 1.125rem; font-weight: 600; color: var(--color-danger); margin: 0;">Kritik Sonuç Bildirimleri</h2>
                    <span style="font-size: 0.8125rem; background: var(--color-danger-bg); color: var(--color-danger); padding: 0.25rem 0.5rem; border-radius: 4px; font-weight: 600;">
                        Toplam @CriticalAlerts.Sum(a => a.CriticalCount) Kritik Değer
                    </span>
                </div>
                <p style="font-size: 0.875rem; color: var(--color-text-muted); margin: 0 0 1rem 0;">
                    Yönetim paneli operasyonel sayaçları gösterir. Klinik hasta detayları ve sonuç içeriğine erişmek için ek klinik izin gereklidir.
                </p>
                <div style="overflow-x: auto;">
                    <table class="ui-table" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>Birim / Modalite</th>
                                <th style="text-align: right;">Kritik Bildirim Adedi</th>
                                <th style="text-align: right;">Son Güncelleme</th>
                                <th style="text-align: center;">Klinik Detay</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in CriticalAlerts)
                            {
                                <tr>
                                    <td style="font-weight: 500;">@alert.ModalityOrSection</td>
                                    <td style="text-align: right; color: var(--color-danger); font-weight: 700;">@alert.CriticalCount</td>
                                    <td style="text-align: right; color: var(--color-text-muted); font-size: 0.8125rem;">@alert.LastUpdatedUtc.ToString("HH:mm:ss") UTC</td>
                                    <td style="text-align: center;">
                                        <a href="diagnostics/critical-results" class="ui-button ui-button--secondary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem; text-decoration: none;">
                                            Klinik İnceleme
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private DateOnly SelectedDate { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);
    private bool IsLoading { get; set; } = true;
    private bool IsForbidden { get; set; }
    private string? ErrorMessage { get; set; }

    private DiagnosticDashboardSummaryResponse? Summary { get; set; }
    private List<DiagnosticModalityMetricResponse> ModalityMetrics { get; set; } = [];
    private List<DiagnosticCriticalAlertMetricResponse> CriticalAlerts { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        IsLoading = true;
        IsForbidden = false;
        ErrorMessage = null;

        try
        {
            var summaryTask = ReportingClient.GetDiagnosticDashboardSummaryAsync(SelectedDate);
            var modTask = ReportingClient.GetDiagnosticModalityMetricsAsync(SelectedDate);
            var alertTask = ReportingClient.GetDiagnosticCriticalAlertMetricsAsync(SelectedDate);

            await Task.WhenAll(summaryTask, modTask, alertTask);

            Summary = await summaryTask;
            ModalityMetrics = await modTask;
            CriticalAlerts = await alertTask;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            IsForbidden = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = "Metrikler yüklenirken bir sorun oluştu: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
