@page "/clinical-handoffs"
@using HospitalManagement.Contracts.Surgery
@using HospitalManagement.Web.Client.Surgery
@inject IClinicalHandoffApiClient HandoffApi

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-arrow-left-right text-primary me-2"></i>Klinik Devir Teslim &amp; ISBAR Panosu
            </h2>
            <p class="text-muted small mb-0">Acil, ameliyathane, yoğun bakım ve yataklı servisler arası güvenli ve standart (ISBAR) klinik devir teslim yönetimi.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="LoadDataAsync" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i>Yenile
            </button>
            <button class="btn btn-primary" @onclick="OpenInitiateModal">
                <i class="bi bi-plus-circle me-1"></i>Yeni Devir Teslim Başlat (ISBAR)
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    <!-- Clinical Ownership & Safety Banner -->
    <div class="alert alert-warning py-2 small d-flex align-items-center mb-4">
        <i class="bi bi-shield-exclamation fs-4 me-2"></i>
        <div>
            <strong>Klinik Sorumluluk &amp; Sahiplik İlkesi:</strong> Devir teslim karşı ekip tarafından resmi olarak <strong>kabul edilene kadar</strong> hastanın klinik sorumluluğu devreden kaynak birimdedir. Karşı taraf devraldığında kabul zamanı ve personeli sisteme mühürlenir.
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold small text-muted">Hedef Birim Filtresi:</span>
                <select class="form-select form-select-sm w-auto" @bind="_selectedDestinationFilter" @bind:after="LoadDataAsync">
                    <option value="">Tüm Alanlar</option>
                    <option value="IntensiveCareUnit">Yoğun Bakım Ünitesi (ICU)</option>
                    <option value="OperatingRoom">Ameliyathane</option>
                    <option value="InpatientWard">Yataklı Servis</option>
                    <option value="Emergency">Acil Servis</option>
                    <option value="PostAnesthesiaCareUnit">PACU (Ayılma)</option>
                </select>
            </div>
            <div class="text-muted small">
                Toplam <strong>@_pendingHandoffs.Count</strong> bekleyen devir teslim kaydı
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Klinik devir teslim kayıtları yükleniyor...</p>
        </div>
    }
    else if (_pendingHandoffs.Count == 0)
    {
        <div class="card border-0 shadow-sm p-5 text-center text-muted">
            <i class="bi bi-check2-circle fs-1 mb-2 text-success"></i>
            <h5>Şu anda onay bekleyen devir teslim bulunmamaktadır.</h5>
            <p>Tüm alanlar arası hasta transferleri tamamlanmış veya henüz yeni bir devir başlatılmamış.</p>
        </div>
    }
    else
    {
        <!-- Pending Handoffs Cards Grid -->
        <div class="row g-4">
            @foreach (var h in _pendingHandoffs)
            {
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100 border-top border-primary border-4">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">
                                    <span class="badge bg-primary me-2">@h.HandoffProtocolNumber</span>
                                </h5>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>@h.HandedOverAtUtc.ToLocalTime().ToString("g")
                                </small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary">@h.SourceArea</span>
                                <i class="bi bi-arrow-right text-muted"></i>
                                <span class="badge bg-success">@h.DestinationArea</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <span class="text-muted small d-block">Kaynak Detayı</span>
                                    <strong>@h.SourceLocationDetails</strong>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted small d-block">Hedef Detayı</span>
                                    <strong>@h.DestinationLocationDetails</strong>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(h.CriticalAlerts))
                            {
                                <div class="alert alert-danger py-2 small mb-3">
                                    <i class="bi bi-exclamation-octagon-fill me-1"></i>
                                    <strong>Kritik Uyarılar:</strong> @h.CriticalAlerts
                                </div>
                            }

                            <!-- ISBAR Box -->
                            <div class="bg-light p-3 rounded mb-3 small">
                                <div class="mb-2">
                                    <strong class="text-primary d-block"><i class="bi bi-info-circle me-1"></i>S - Durum (Situation):</strong>
                                    <span>@h.Situation</span>
                                </div>
                                <div class="mb-2">
                                    <strong class="text-secondary d-block"><i class="bi bi-clock-history me-1"></i>B - Geçmiş (Background):</strong>
                                    <span>@h.Background</span>
                                </div>
                                <div class="mb-2">
                                    <strong class="text-warning text-dark d-block"><i class="bi bi-clipboard2-pulse me-1"></i>A - Değerlendirme &amp; Bulgular (Assessment):</strong>
                                    <span>@h.Assessment</span>
                                </div>
                                <div>
                                    <strong class="text-success d-block"><i class="bi bi-list-check me-1"></i>R - Öneriler &amp; Açık Görevler (Recommendation):</strong>
                                    <span>@h.Recommendation</span>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <button class="btn btn-success btn-sm flex-fill" @onclick="() => OpenAcceptModal(h)">
                                    <i class="bi bi-check-lg me-1"></i>Kabul Et &amp; Devral
                                </button>
                                <button class="btn btn-outline-danger btn-sm flex-fill" @onclick="() => OpenRejectModal(h)">
                                    <i class="bi bi-x-lg me-1"></i>Reddet / Revizyon İste
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenCancelModal(h)">
                                    <i class="bi bi-trash me-1"></i>İptal Et
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal: Yeni Devir Teslim Başlat (ISBAR) -->
@if (_showInitiateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Yeni Klinik Devir Teslim Başlat (ISBAR)</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showInitiateModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Hasta ID <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_initiatePatientIdStr" placeholder="Hasta Guid" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Yatış Takip ID (InpatientStayId)</label>
                            <input type="text" class="form-control" @bind="_initiateStayIdStr" placeholder="Yatış Takip Guid (opsiyonel)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Kaynak Alan</label>
                            <select class="form-select" @bind="_initiateRequest.SourceArea">
                                <option value="Emergency">Acil Servis</option>
                                <option value="OperatingRoom">Ameliyathane</option>
                                <option value="IntensiveCareUnit">Yoğun Bakım Ünitesi (ICU)</option>
                                <option value="InpatientWard">Yataklı Servis</option>
                                <option value="PostAnesthesiaCareUnit">PACU (Ayılma)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Kaynak Konum / Detay <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_initiateRequest.SourceLocationDetails" placeholder="Örn: Kırmızı Alan Yatak 2" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Hedef Alan</label>
                            <select class="form-select" @bind="_initiateRequest.DestinationArea">
                                <option value="IntensiveCareUnit">Yoğun Bakım Ünitesi (ICU)</option>
                                <option value="OperatingRoom">Ameliyathane</option>
                                <option value="InpatientWard">Yataklı Servis</option>
                                <option value="Emergency">Acil Servis</option>
                                <option value="PostAnesthesiaCareUnit">PACU (Ayılma)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Hedef Konum / Detay <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_initiateRequest.DestinationLocationDetails" placeholder="Örn: ICU Yatak 1 / Salon 2" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-danger">Kritik Uyarılar &amp; İzolasyon</label>
                            <input type="text" class="form-control" @bind="_initiateRequest.CriticalAlerts" placeholder="Örn: Temas İzolasyonu (MRSA+), Zor Hava Yolu, Yüksek Düşme Riski" />
                        </div>

                        <!-- ISBAR Inputs -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-primary">S - Durum (Situation) <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" @bind="_initiateRequest.Situation" placeholder="62 yaş erkek hasta, akut apandisit perforasyonu ve peritonit tablosu..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary">B - Geçmiş (Background) <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" @bind="_initiateRequest.Background" placeholder="HT, Tip 2 DM, penisilin alerjisi mevcut. Acilde 2000ml İV hidrasyon ve Seftriakson başlandı..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-warning text-dark">A - Değerlendirme &amp; Bulgular (Assessment) <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" @bind="_initiateRequest.Assessment" placeholder="TA: 100/60 mmHg, HR: 110 bpm, SpO2: %95, Batın defans+, Laktat: 2.8 mmol/L..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-success">R - Öneriler &amp; Açık Görevler (Recommendation) <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" @bind="_initiateRequest.Recommendation" placeholder="Acil ameliyathaneye devredildi, pre-op antibiyotik tamamlandı, 2 saat sonra kontrol kan gazı planlandı..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showInitiateModal = false">Vazgeç</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitInitiateAsync" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Devir Teslimi Başlat
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Devir Teslimi Kabul Et -->
@if (_showAcceptModal && _selectedHandoff != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-check-circle me-2"></i>Devir Teslimi Kabul Et (@_selectedHandoff.HandoffProtocolNumber)</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showAcceptModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>Hastanın klinik sorumluluğunu ve açık bakım görevlerini devralmayı onaylıyor musunuz?</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kabul / Teslim Alma Notu (opsiyonel)</label>
                        <textarea class="form-control" rows="3" @bind="_acceptRequest.AcceptanceNote" placeholder="Hasta yatağında stabil teslim alındı, monitörizasyon bağlandı..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showAcceptModal = false">Vazgeç</button>
                    <button type="button" class="btn btn-success" @onclick="SubmitAcceptAsync" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Onayla ve Devral
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Devir Teslimi Reddet / Revizyon İste -->
@if (_showRejectModal && _selectedHandoff != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-x-circle me-2"></i>Devir Teslimi Reddet / Revizyon İste (@_selectedHandoff.HandoffProtocolNumber)</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showRejectModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ret / Revizyon Gerekçesi <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" @bind="_rejectRequest.RejectionReason" placeholder="Hasta entübe değil veya eksik tetkikler var, stabilizasyon sonrası tekrar devrediniz..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showRejectModal = false">Vazgeç</button>
                    <button type="button" class="btn btn-danger" @onclick="SubmitRejectAsync" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Reddi Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Devir Teslimi İptal Et -->
@if (_showCancelModal && _selectedHandoff != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title"><i class="bi bi-trash me-2"></i>Devir Teslimi İptal Et (@_selectedHandoff.HandoffProtocolNumber)</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showCancelModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">İptal Gerekçesi <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" @bind="_cancelRequest.CancelReason" placeholder="Klinik durum değişti, transfer ertelendi..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showCancelModal = false">Vazgeç</button>
                    <button type="button" class="btn btn-secondary" @onclick="SubmitCancelAsync" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        İptal Et
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _successMessage;

    private List<ClinicalHandoffResponse> _pendingHandoffs = [];
    private string _selectedDestinationFilter = string.Empty;

    private bool _showInitiateModal;
    private InitiateClinicalHandoffRequest _initiateRequest = new();
    private string _initiatePatientIdStr = string.Empty;
    private string _initiateStayIdStr = string.Empty;

    private bool _showAcceptModal;
    private bool _showRejectModal;
    private bool _showCancelModal;
    private ClinicalHandoffResponse? _selectedHandoff;
    private AcceptClinicalHandoffRequest _acceptRequest = new();
    private RejectClinicalHandoffRequest _rejectRequest = new();
    private CancelClinicalHandoffRequest _cancelRequest = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _pendingHandoffs = await HandoffApi.GetPendingHandoffsAsync(
                string.IsNullOrWhiteSpace(_selectedDestinationFilter) ? null : _selectedDestinationFilter);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Veriler yüklenirken hata: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenInitiateModal()
    {
        _initiateRequest = new InitiateClinicalHandoffRequest
        {
            SourceArea = "Emergency",
            DestinationArea = "IntensiveCareUnit",
        };
        _initiatePatientIdStr = string.Empty;
        _initiateStayIdStr = string.Empty;
        _showInitiateModal = true;
    }

    private async Task SubmitInitiateAsync()
    {
        if (!Guid.TryParse(_initiatePatientIdStr, out var patientId) || patientId == Guid.Empty)
        {
            _errorMessage = "Geçerli bir Hasta ID giriniz.";
            return;
        }

        Guid? stayId = null;
        if (Guid.TryParse(_initiateStayIdStr, out var sId) && sId != Guid.Empty)
        {
            stayId = sId;
        }

        _initiateRequest.PatientId = patientId;
        _initiateRequest.InpatientStayId = stayId;

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var res = await HandoffApi.InitiateHandoffAsync(_initiateRequest);
            if (res != null)
            {
                _successMessage = $"Klinik devir teslim başarıyla başlatıldı ({res.HandoffProtocolNumber}).";
                _showInitiateModal = false;
                await LoadDataAsync();
            }
            else
            {
                _errorMessage = "Devir teslim başlatılamadı. Alanları kontrol ediniz.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Devir başlatma hatası: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenAcceptModal(ClinicalHandoffResponse handoff)
    {
        _selectedHandoff = handoff;
        _acceptRequest = new AcceptClinicalHandoffRequest();
        _showAcceptModal = true;
    }

    private async Task SubmitAcceptAsync()
    {
        if (_selectedHandoff == null) return;

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var res = await HandoffApi.AcceptHandoffAsync(_selectedHandoff.Id, _acceptRequest);
            if (res != null)
            {
                _successMessage = $"Devir teslim kabul edildi. Klinik sorumluluk devralındı ({_selectedHandoff.HandoffProtocolNumber}).";
                _showAcceptModal = false;
                await LoadDataAsync();
            }
            else
            {
                _errorMessage = "Devir teslim kabul edilemedi.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Kabul hatası: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenRejectModal(ClinicalHandoffResponse handoff)
    {
        _selectedHandoff = handoff;
        _rejectRequest = new RejectClinicalHandoffRequest();
        _showRejectModal = true;
    }

    private async Task SubmitRejectAsync()
    {
        if (_selectedHandoff == null) return;

        if (string.IsNullOrWhiteSpace(_rejectRequest.RejectionReason))
        {
            _errorMessage = "Ret / revizyon gerekçesi giriniz.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var res = await HandoffApi.RejectHandoffAsync(_selectedHandoff.Id, _rejectRequest);
            if (res != null)
            {
                _successMessage = "Devir teslim reddedildi ve gerekçesi kaydedildi.";
                _showRejectModal = false;
                await LoadDataAsync();
            }
            else
            {
                _errorMessage = "Red işlemi gerçekleştirilemedi.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ret hatası: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenCancelModal(ClinicalHandoffResponse handoff)
    {
        _selectedHandoff = handoff;
        _cancelRequest = new CancelClinicalHandoffRequest();
        _showCancelModal = true;
    }

    private async Task SubmitCancelAsync()
    {
        if (_selectedHandoff == null) return;

        if (string.IsNullOrWhiteSpace(_cancelRequest.CancelReason))
        {
            _errorMessage = "İptal gerekçesi giriniz.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var res = await HandoffApi.CancelHandoffAsync(_selectedHandoff.Id, _cancelRequest);
            if (res != null)
            {
                _successMessage = "Devir teslim iptal edildi.";
                _showCancelModal = false;
                await LoadDataAsync();
            }
            else
            {
                _errorMessage = "İptal işlemi gerçekleştirilemedi.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"İptal hatası: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
