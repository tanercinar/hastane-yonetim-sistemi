@page "/icu/beds"
@using HospitalManagement.Contracts.Surgery
@using HospitalManagement.Web.Client.Surgery
@inject IIcuApiClient IcuApi

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-heart-pulse-fill text-danger me-2"></i>Yoğun Bakım Ünitesi &amp; Yatak Yönetimi
            </h2>
            <p class="text-muted small mb-0">ICU yatak doluluk durumu, kritik hasta basamak seviyeleri, ventilatör takibi ve servis devirleri.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="LoadDataAsync" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i>Yenile
            </button>
            <button class="btn btn-danger" @onclick="OpenAdmitModal">
                <i class="bi bi-box-arrow-in-right me-1"></i>Yoğun Bakıma Hasta Kabul Et
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="text-muted small">Toplam ICU Yatak</div>
                <div class="fs-4 fw-bold text-dark">@_beds.Count</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="text-muted small">Dolu Yatak</div>
                <div class="fs-4 fw-bold text-danger">@_beds.Count(b => b.IsOccupied)</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="text-muted small">Müsait Yatak</div>
                <div class="fs-4 fw-bold text-success">@_beds.Count(b => !b.IsOccupied)</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="text-muted small">Basamak 3 (Çoklu Organ Destek)</div>
                <div class="fs-4 fw-bold text-danger">@_activeAdmissions.Count(a => a.AcuityLevel == "Level3MultiOrganSupport")</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="text-muted small">İnvaziv Mekanik Ventilasyon</div>
                <div class="fs-4 fw-bold text-warning">@_activeAdmissions.Count(a => a.VentilationMode == "InvasiveMechanical")</div>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Yoğun bakım yatakları ve aktif hastalar yükleniyor...</p>
        </div>
    }
    else
    {
        <!-- Beds Grid -->
        <div class="row g-4">
            @foreach (var bed in _beds)
            {
                var admission = _activeAdmissions.FirstOrDefault(a => a.IcuBedId == bed.Id);
                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100 @(bed.IsOccupied ? "border-start border-danger border-4" : "border-start border-success border-4")">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">
                                    <i class="bi bi-hospital text-primary me-2"></i>@bed.BedCode
                                </h5>
                                <small class="text-muted">@bed.BedName</small>
                            </div>
                            <div>
                                @if (bed.IsOccupied)
                                {
                                    <span class="badge bg-danger">DOLU</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">MÜSAİT</span>
                                }
                            </div>
                        </div>

                        <div class="card-body">
                            @if (bed.IsOccupied && admission != null)
                            {
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Protokol / Kabul</span>
                                    <strong class="font-monospace text-primary">@admission.AdmissionProtocolNumber</strong>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Kabul Gerekçesi</span>
                                    <div class="fw-bold text-dark">@admission.AdmissionReason</div>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <span class="text-muted small d-block">Kritiklik Seviyesi</span>
                                        @GetAcuityBadge(admission.AcuityLevel)
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted small d-block">Ventilasyon</span>
                                        @GetVentilationBadge(admission.VentilationMode)
                                    </div>
                                </div>
                                <div class="row g-2 mb-3 small text-muted">
                                    <div class="col-6">
                                        <i class="bi bi-clock me-1"></i>İzlem: @admission.MonitoringFrequencyMinutes dk
                                    </div>
                                    <div class="col-6">
                                        <i class="bi bi-calendar-check me-1"></i>Giriş: @admission.AdmittedAtUtc.ToLocalTime().ToString("g")
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(admission.CarePlanNotes))
                                {
                                    <div class="p-2 bg-light rounded small text-dark mb-3">
                                        <strong>Bakım Notu:</strong> @admission.CarePlanNotes
                                    </div>
                                }
                                <div class="d-flex flex-wrap gap-2 mt-auto">
                                    <a class="btn btn-danger btn-sm flex-fill text-white text-decoration-none text-center" href="icu/flowsheet/@admission.Id">
                                        <i class="bi bi-activity me-1"></i>Akış Sayfası
                                    </a>
                                    <button class="btn btn-outline-primary btn-sm flex-fill" @onclick="() => OpenCarePlanModal(admission)">
                                        <i class="bi bi-sliders me-1"></i>Bakım Planı
                                    </button>
                                    <button class="btn btn-outline-warning btn-sm flex-fill" @onclick="() => OpenDischargeModal(admission)">
                                        <i class="bi bi-box-arrow-right me-1"></i>Devir / Taburcu
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-check-circle-fill text-success fs-1 mb-2 d-block"></i>
                                    <p class="mb-3">Bu yatak şu anda boş ve yeni hasta kabulüne hazırdır.</p>
                                    <button class="btn btn-outline-success btn-sm" @onclick="() => OpenAdmitForBedModal(bed)">
                                        <i class="bi bi-plus-circle me-1"></i>Bu Yatağa Yatır
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal: Yoğun Bakıma Hasta Kabul Et -->
@if (_showAdmitModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-box-arrow-in-right me-2"></i>Yoğun Bakıma Hasta Kabul &amp; Yatak Ataması</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showAdmitModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Yatış Takip ID (InpatientStayId) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_admitStayIdStr" placeholder="Örn: 00000000-0000-0000-0000-000000000101" />
                            <small class="text-muted">Tek yatış hareket zinciri için zorunludur.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Hasta ID <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_admitPatientIdStr" placeholder="Hasta Guid" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Yoğun Bakım Yatağı <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="_admitRequest.IcuBedId">
                                <option value="@Guid.Empty">-- Yatak Seçiniz --</option>
                                @foreach (var bed in _beds.Where(b => !b.IsOccupied || b.Id == _admitRequest.IcuBedId))
                                {
                                    <option value="@bed.Id">@bed.BedCode - @bed.BedName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Sorumlu Hekim ID <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_admitDoctorIdStr" placeholder="Sorumlu Yoğun Bakım Uzmanı Guid" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Kritiklik Basamağı</label>
                            <select class="form-select" @bind="_admitRequest.AcuityLevel">
                                <option value="Level3MultiOrganSupport">Basamak 3 - Çoklu Organ Desteği / Yüksek Risk</option>
                                <option value="Level2IntensiveMonitoring">Basamak 2 - Yoğun Hemodinamik İzlem</option>
                                <option value="Level1HighDependency">Basamak 1 - Yüksek Bağımlı Bakım</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ventilasyon Modu</label>
                            <select class="form-select" @bind="_admitRequest.VentilationMode">
                                <option value="NoneSpontaneous">Spontan Solunum (Oda Havası / Nazal O2)</option>
                                <option value="HighFlowNasalCannula">Yüksek Akışlı Nazal Kanül (HFNC)</option>
                                <option value="NonInvasiveCpapBiPap">Non-İnvaziv Mekanik Ventilasyon (NIV/CPAP/BiPAP)</option>
                                <option value="InvasiveMechanical">İnvaziv Mekanik Ventilasyon (Endotrakeal)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">İzlem Sıklığı (Dakika)</label>
                            <input type="number" class="form-control" @bind="_admitRequest.MonitoringFrequencyMinutes" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Primer Hemşire ID (opsiyonel)</label>
                            <input type="text" class="form-control" @bind="_admitNurseIdStr" placeholder="Sorumlu Hemşire Guid" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Yoğun Bakım Kabul Gerekçesi <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_admitRequest.AdmissionReason" placeholder="Örn: Post-Op solunum yetmezliği ve inotrop desteği" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Bakım Planı ve Hedefler</label>
                            <textarea class="form-control" rows="3" @bind="_admitRequest.CarePlanNotes" placeholder="Hedef MAP > 65 mmHg, saatlik diürez takibi, sedasyon protokolü..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showAdmitModal = false">Vazgeç</button>
                    <button type="button" class="btn btn-danger" @onclick="SubmitAdmitAsync" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Kabulü Gerçekleştir
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Bakım Planı Güncelle -->
@if (_showCarePlanModal && _selectedAdmission != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-sliders me-2"></i>Bakım Planı Güncelle (@_selectedAdmission.IcuBedCode)</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showCarePlanModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kritiklik Seviyesi</label>
                        <select class="form-select" @bind="_carePlanRequest.AcuityLevel">
                            <option value="Level3MultiOrganSupport">Basamak 3 - Çoklu Organ Desteği</option>
                            <option value="Level2IntensiveMonitoring">Basamak 2 - Yoğun Hemodinamik İzlem</option>
                            <option value="Level1HighDependency">Basamak 1 - Yüksek Bağımlı Bakım</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ventilasyon Modu</label>
                        <select class="form-select" @bind="_carePlanRequest.VentilationMode">
                            <option value="NoneSpontaneous">Spontan Solunum</option>
                            <option value="HighFlowNasalCannula">Yüksek Akışlı Nazal Kanül (HFNC)</option>
                            <option value="NonInvasiveCpapBiPap">Non-İnvaziv Ventilasyon (NIV)</option>
                            <option value="InvasiveMechanical">İnvaziv Mekanik Ventilasyon</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">İzlem Sıklığı (Dakika)</label>
                        <input type="number" class="form-control" @bind="_carePlanRequest.MonitoringFrequencyMinutes" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Bakım Notları &amp; Revizyonlar</label>
                        <textarea class="form-control" rows="4" @bind="_carePlanRequest.CarePlanNotes"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showCarePlanModal = false">Vazgeç</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitCarePlanAsync" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Güncelle
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Servise Devir / Taburcu -->
@if (_showDischargeModal && _selectedAdmission != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title"><i class="bi bi-box-arrow-right me-2"></i>Yoğun Bakım Çıkış / Devir (@_selectedAdmission.IcuBedCode)</h5>
                    <button type="button" class="btn-close" @onclick="() => _showDischargeModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hedef Çıkış Durumu <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="_dischargeRequest.DestinationStatus">
                            <option value="TransferredToWard">Cerrahi / Dahili Yataklı Servise Devir</option>
                            <option value="Discharged">Doğrudan Taburculuk</option>
                            <option value="Deceased">Eksitus (Vefat)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Çıkış / Devir Epikriz Notu <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="4" @bind="_dischargeRequest.DischargeNotes" placeholder="Hasta hemodinamik olarak stabil, extübe edildi, servise devredildi..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showDischargeModal = false">Vazgeç</button>
                    <button type="button" class="btn btn-warning" @onclick="SubmitDischargeAsync" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Çıkışı Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _successMessage;

    private List<IcuBedResponse> _beds = [];
    private List<IcuAdmissionResponse> _activeAdmissions = [];

    private bool _showAdmitModal;
    private CreateIcuAdmissionRequest _admitRequest = new();
    private string _admitStayIdStr = string.Empty;
    private string _admitPatientIdStr = string.Empty;
    private string _admitDoctorIdStr = string.Empty;
    private string _admitNurseIdStr = string.Empty;

    private bool _showCarePlanModal;
    private IcuAdmissionResponse? _selectedAdmission;
    private UpdateIcuCarePlanRequest _carePlanRequest = new();

    private bool _showDischargeModal;
    private IcuDischargeOrTransferRequest _dischargeRequest = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _beds = await IcuApi.GetIcuBedsAsync();
            _activeAdmissions = await IcuApi.GetActiveAdmissionsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Veriler yüklenirken hata oluştu: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAdmitModal()
    {
        _admitRequest = new CreateIcuAdmissionRequest
        {
            AcuityLevel = "Level2IntensiveMonitoring",
            MonitoringFrequencyMinutes = 60,
            VentilationMode = "NoneSpontaneous",
        };
        _admitStayIdStr = string.Empty;
        _admitPatientIdStr = string.Empty;
        _admitDoctorIdStr = string.Empty;
        _admitNurseIdStr = string.Empty;
        _showAdmitModal = true;
    }

    private void OpenAdmitForBedModal(IcuBedResponse bed)
    {
        OpenAdmitModal();
        _admitRequest.IcuBedId = bed.Id;
    }

    private async Task SubmitAdmitAsync()
    {
        if (!Guid.TryParse(_admitStayIdStr, out var stayId) || stayId == Guid.Empty)
        {
            _errorMessage = "Geçerli bir Yatış Takip ID (InpatientStayId) giriniz.";
            return;
        }

        if (!Guid.TryParse(_admitPatientIdStr, out var patId) || patId == Guid.Empty)
        {
            _errorMessage = "Geçerli bir Hasta ID giriniz.";
            return;
        }

        if (!Guid.TryParse(_admitDoctorIdStr, out var docId) || docId == Guid.Empty)
        {
            _errorMessage = "Geçerli bir Sorumlu Hekim ID giriniz.";
            return;
        }

        if (_admitRequest.IcuBedId == Guid.Empty)
        {
            _errorMessage = "Yoğun bakım yatağı seçiniz.";
            return;
        }

        Guid? nurseId = null;
        if (Guid.TryParse(_admitNurseIdStr, out var nId) && nId != Guid.Empty)
        {
            nurseId = nId;
        }

        _admitRequest.InpatientStayId = stayId;
        _admitRequest.PatientId = patId;
        _admitRequest.AttendingDoctorId = docId;
        _admitRequest.PrimaryNurseId = nurseId;

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var res = await IcuApi.AdmitToIcuAsync(_admitRequest);
            if (res != null)
            {
                _successMessage = $"Hasta {res.IcuBedCode} yatağına başarıyla kabul edildi ({res.AdmissionProtocolNumber}).";
                _showAdmitModal = false;
                await LoadDataAsync();
            }
            else
            {
                _errorMessage = "Kabul işlemi gerçekleştirilemedi. Yatak çakışması veya aktif yatış kontrolü yapınız.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Kabul hatası: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenCarePlanModal(IcuAdmissionResponse admission)
    {
        _selectedAdmission = admission;
        _carePlanRequest = new UpdateIcuCarePlanRequest(
            admission.AcuityLevel,
            admission.MonitoringFrequencyMinutes,
            admission.VentilationMode,
            admission.PrimaryNurseId,
            admission.CarePlanNotes);
        _showCarePlanModal = true;
    }

    private async Task SubmitCarePlanAsync()
    {
        if (_selectedAdmission == null) return;

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var res = await IcuApi.UpdateCarePlanAsync(_selectedAdmission.Id, _carePlanRequest);
            if (res != null)
            {
                _successMessage = "Bakım planı başarıyla güncellendi.";
                _showCarePlanModal = false;
                await LoadDataAsync();
            }
            else
            {
                _errorMessage = "Bakım planı güncellenemedi.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Güncelleme hatası: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenDischargeModal(IcuAdmissionResponse admission)
    {
        _selectedAdmission = admission;
        _dischargeRequest = new IcuDischargeOrTransferRequest("TransferredToWard", string.Empty);
        _showDischargeModal = true;
    }

    private async Task SubmitDischargeAsync()
    {
        if (_selectedAdmission == null) return;

        if (string.IsNullOrWhiteSpace(_dischargeRequest.DischargeNotes))
        {
            _errorMessage = "Çıkış / devir notu giriniz.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var res = await IcuApi.DischargeOrTransferAsync(_selectedAdmission.Id, _dischargeRequest);
            if (res != null)
            {
                _successMessage = $"Hasta yoğun bakımdan sevk edildi. {_selectedAdmission.IcuBedCode} yatağı boşaltıldı.";
                _showDischargeModal = false;
                await LoadDataAsync();
            }
            else
            {
                _errorMessage = "Çıkış işlemi gerçekleştirilemedi.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Çıkış hatası: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static RenderFragment GetAcuityBadge(string acuity) => builder =>
    {
        var (cls, label) = acuity switch
        {
            "Level3MultiOrganSupport" => ("bg-danger", "Basamak 3 (Organ Desteği)"),
            "Level2IntensiveMonitoring" => ("bg-warning text-dark", "Basamak 2 (İzlem)"),
            "Level1HighDependency" => ("bg-info text-dark", "Basamak 1 (Yüksek Bağımlı)"),
            _ => ("bg-secondary", acuity)
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cls}");
        builder.AddContent(2, label);
        builder.CloseElement();
    };

    private static RenderFragment GetVentilationBadge(string vent) => builder =>
    {
        var (cls, label) = vent switch
        {
            "InvasiveMechanical" => ("bg-danger", "İnvaziv Mekanik"),
            "NonInvasiveCpapBiPap" => ("bg-warning text-dark", "NIV / CPAP / BiPAP"),
            "HighFlowNasalCannula" => ("bg-info text-dark", "HFNC Yüksek Akış"),
            "NoneSpontaneous" => ("bg-success", "Spontan"),
            _ => ("bg-secondary", vent)
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cls}");
        builder.AddContent(2, label);
        builder.CloseElement();
    };
}
