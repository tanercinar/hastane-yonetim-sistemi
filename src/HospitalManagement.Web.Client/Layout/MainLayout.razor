    <button type="button" class="dismiss" aria-label="@Localizer["DismissError"]">×</button>
</div>

@code {
    private bool CanViewInpatientClinicalArea => HasAnyPermission(
        "admission.request",
        "admission.accept",
        "bed.assign",
        "bed.transfer",
        "care-plan.manage",
        "medication.administer",
        "discharge.complete");

    private bool CanManageNursingCare => SessionState.HasPermission("care-plan.manage");
    private bool CanAdministerMedication => SessionState.HasPermission("medication.administer");
    private bool CanCompleteDischarge => SessionState.HasPermission("discharge.complete");
    private bool CanTransferBed => SessionState.HasPermission("bed.transfer");
    private bool CanManageBeds => HasAnyPermission("bed.assign", "bed.transfer");
    private bool CanManageAdmissions => HasAnyPermission("admission.request", "admission.accept", "bed.assign");
    private bool CanUseEmergency => SessionState.HasPermission("emergency.triage.record");
    private bool CanScheduleSurgery => SessionState.HasPermission("surgery.schedule");
    private bool CanUseCriticalCare => SessionState.HasPermission("critical-care.record");
    private bool CanUseSpecialtyCare => SessionState.HasPermission("specialty-care.record");
    private bool CanViewOwnSpecialtyRecords => SessionState.HasPermission("specialty-care.view-own");
    private bool CanViewReporting => SessionState.HasPermission("reporting.view");

    protected override async Task OnInitializedAsync()
    {
        SessionState.OnChange += HandleStateChanged;
        await SessionState.EnsureLoadedAsync();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogoutAsync()
    {
        await SessionState.LogoutAsync();
        Navigation.NavigateTo("account/login");
    }

    public void Dispose()
    {
        SessionState.OnChange -= HandleStateChanged;
    }

    private bool HasAnyPermission(params string[] permissions) =>
        permissions.Any(SessionState.HasPermission);
}
